# ==============================================================================
# Environment Configuration (.env.example)
# Production-ready for Netlify Deployment & Firebase / Google Integrations
# ==============================================================================

# Session & Security
# REQUIRED in production: Random secret of at least 32 characters
SESSION_SECRET=simran_secure_production_secret_32_characters_minimum

# Admin Access Credentials
# OPTIONAL: Defaults to simranarrora.p@gmail.com / Admin@123456
ADMIN_EMAIL=simranarrora.p@gmail.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Simran Arrora

# Public Application Base URL
# OPTIONAL: Defaults to http://localhost:3000 or Netlify production domain
APP_URL=https://simranarrora.netlify.app

# Firebase Configuration (Production Database & Authentication)
# OPTIONAL if using firebase-applet-config.json; otherwise set project ID
FIREBASE_PROJECT_ID=gen-lang-client-0442308093

# Google OAuth & Identity (Client-side & Server Sign-In)
# OPTIONAL: Enables Google Sign-In on customer & admin portal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://simranarrora.netlify.app/auth/google/callback

# Google Workspace Server Integrations
# OPTIONAL: For automated server-side Calendar, Sheets, Drive & Gmail synchronization
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
GOOGLE_DRIVE_FOLDER_ID=
GMAIL_USER=
GMAIL_PASS=

# Razorpay Payment Integration
# OPTIONAL: Overrides or defaults the admin payment link
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@simranarrora
