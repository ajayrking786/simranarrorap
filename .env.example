# ==============================================================================
# Application Configuration (.env.example)
# All variables are OPTIONAL for local development and running the web app.
# The app will start and run with SQLite defaults even if none are configured.
# ==============================================================================

# Session Security (Recommended in production; 32+ characters)
SESSION_SECRET=your_32_character_session_secret_here

# Initial Admin Credentials (Optional; defaults to Admin / admin@simranarrora.com / Admin@123456)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Public App Base URL (Optional; defaults to http://localhost:3000)
APP_URL=http://localhost:3000

# Google OAuth & Sign-In (Optional: enables Google login on customer portal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Calendar, Meet, Sheets & Gmail Sync (Optional: requires refresh token with relevant scopes)
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
GMAIL_USER=

# External Payment Link (Optional; can also be configured in the admin dashboard)
RAZORPAY_PAYMENT_LINK=
