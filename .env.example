# Environment Variables — Simran Arrora Web

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin Credentials (used only for seeding, never exposed to browser) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# ─── Razorpay (server-side only — NEVER use NEXT_PUBLIC_ for SECRET) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Resend Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Google Sheets (server-side only) ────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
